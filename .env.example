# Sao chép file này thành `.env` rồi điền giá trị thật. KHÔNG commit file `.env`.
# Biến có tiền tố EXPO_PUBLIC_ sẽ được nhúng vào app => chỉ dùng cho giá trị KHÔNG bí mật.

# Môi trường chạy: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Máy chủ gia đình PocketBase (Milestone 2.5). Khi phát triển: IP máy tính chạy server/ trong mạng Wi-Fi nhà,
# VD http://192.168.1.10:8090 (xem server/README.md). Để trống = app chạy offline hoàn toàn.
EXPO_PUBLIC_POCKETBASE_URL=

# Bật tính năng gia đình (1 = bật). Mặc định TẮT. Chỉ bật khi thử nghiệm nội bộ với dữ liệu giả /
# người nhà đã đồng ý bằng văn bản — hoặc sau khi qua "Cổng pháp lý B" (docs/LEGAL_COMPLIANCE_VN.md).
EXPO_PUBLIC_FAMILY_FEATURE=0
